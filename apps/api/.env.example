DATABASE_URL="file:./dev.db"
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
COOKIE_SECRET="change-me"
SESSION_TTL_HOURS=168
OTP_TTL_MINUTES=10
# Zero-PII / ZK (required in production)
PII_PEPPER="dev-pii-pepper-change-in-production"
SEAL_KEY="dev-seal-key-change-in-production-please-32b"
# ALLOW_LEGACY_PII_SCOPES=true
# EXPOSE_SESSION_TOKEN_IN_BODY=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TrustID
WEBAUTHN_ORIGIN=http://localhost:5173
# Attestation / MDS policy (default keeps V1 compat: none + off)
# WEBAUTHN_ATTESTATION=direct
# WEBAUTHN_ATTESTATION_MODE=soft
# WEBAUTHN_MIN_SECURITY_LEVEL=tee
# WEBAUTHN_REQUIRE_KNOWN_AAGUID=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LIFEOS_REDIRECT_URI=http://localhost:5174/callback
# Optional Redis URL for multi-instance face-vector hot cache (falls back to in-process LRU)
# REDIS_URL=redis://default:password@host:6379
# Optional override for cosine distance threshold on fast vector match (default 0.35)
# FAST_VECTOR_MAX_DISTANCE=0.35

# --- BaaS consumers (TrustID is IdP; these are outbound primitives) ---
# ELFCOM_MODE=http
# ELFCOM_BASE_URL=https://elfcomnode-production.up.railway.app
# ELFCOM_NODE_SECRET=change-me
# DATAZONE_MODE=http
# DATAZONE_BASE_URL=https://sovereign-drive-engine-production.up.railway.app
# DATAZONE_JWT_SECRET=change-me
# DATAZONE_JWT_ISSUER=https://trust-id.local
# DATAZONE_JWT_AUDIENCE=data-zone
# FINPROV_MODE=embedded
# FINPROV_BASE_URL=http://localhost:8793
# LIDIOS_MODE=http
# LIDIOS_BASE_URL=https://token-network-production.up.railway.app
# DIGICONOMY_MODE=unbound
# DIGICONOMY_BASE_URL=http://localhost:8795
# PLATFORM_JOB_MODE=http
# PLATFORM_JOB_BASE_URL=http://localhost:4070
# PLATFORM_JOB_JWT_SECRET=dev-trust-id-secret
# PLATFORM_JOB_JWT_ISSUER=lifeos-trust-id
# PLATFORM_JOB_JWT_AUDIENCE=platform-jobs-engine
# MASTER_DISTRIBUTION_MODE=http
# MASTER_DISTRIBUTION_BASE_URL=http://localhost:3100
# MASTER_DISTRIBUTION_JWT_SECRET=dev-trust-id-secret-change-me

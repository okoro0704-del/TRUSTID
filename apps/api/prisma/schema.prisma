generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  trustId   String   @unique @map("trust_id")
  status    String   @default("pending_verification")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile                 Profile?
  contactMethods          ContactMethod[]
  devices                 Device[]
  credentials             Credential[]
  sessions                Session[]
  authorizations          Authorization[]
  auditEvents             AuditEvent[]
  recoveryMethods         RecoveryMethod[]
  devicePairingRequests   DevicePairingRequest[]
  webauthnChallenges      WebAuthnChallenge[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]
  identityVerifications   IdentityVerification[]
  accountPreferences      AccountPreferences?
  deviceApprovalRequests  DeviceApprovalRequest[]
  securityNotifications   SecurityNotification[]
  verifiedIdentityProfile VerifiedIdentityProfile?
  identityPortraits       IdentityPortrait[]
  identityMediaObjects    IdentityMediaObject[]
  impersonationReportsFiled ImpersonationReport[] @relation("ImpersonationReporter")
  impersonationReportsAbout ImpersonationReport[] @relation("ImpersonationSubject")
  assertionJtIs           AssertionJti[]

  @@map("users")
}

model Profile {
  userId         String  @id @map("user_id")
  /// Commitment only — plaintext names never stored
  nameCommitment String? @map("name_commitment")
  nameSalt       String? @map("name_salt")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model ContactMethod {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  type        String
  /// Peppered HMAC of normalized contact — unique lookup, no plaintext
  lookupHash  String    @map("lookup_hash")
  /// Blind commitment for ZK uniqueness proofs
  commitment  String
  salt        String
  verifiedAt  DateTime? @map("verified_at")
  isPrimary   Boolean   @default(false) @map("is_primary")
  createdAt   DateTime  @default(now()) @map("created_at")

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenges   VerificationChallenge[]
  recoveryRefs RecoveryMethod[]

  @@unique([type, lookupHash])
  @@index([userId])
  @@index([lookupHash])
  @@map("contact_methods")
}

model VerificationChallenge {
  id              String    @id @default(cuid())
  contactMethodId String    @map("contact_method_id")
  codeHash        String    @map("code_hash")
  expiresAt       DateTime  @map("expires_at")
  attempts        Int       @default(0)
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  contactMethod ContactMethod @relation(fields: [contactMethodId], references: [id], onDelete: Cascade)

  @@index([contactMethodId])
  @@map("verification_challenges")
}

model Device {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  name         String
  /// active | revoked (legacy "trusted" treated as active)
  status       String    @default("active")
  /// primary | standard | temporary
  trustLevel   String    @default("standard") @map("trust_level")
  /// Logical device/browser label class — not a hardware identity guarantee
  deviceType   String?   @map("device_type")
  userAgent    String?   @map("user_agent")
  platform     String?
  lastIp       String?   @map("last_ip")
  lastLocation String?   @map("last_location")
  lastActiveAt DateTime? @map("last_active_at")
  trustedAt    DateTime  @default(now()) @map("trusted_at")
  revokedAt    DateTime? @map("revoked_at")
  /// When trustLevel=temporary, session/device trust ends at this time
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials             Credential[]
  sessions                Session[]
  approvedPairingRequests DevicePairingRequest[]   @relation("ApprovedByDevice")
  approvedApprovals       DeviceApprovalRequest[]  @relation("ApprovedByDevice")
  resultingApprovals      DeviceApprovalRequest[]  @relation("ResultingDevice")

  @@index([userId])
  @@index([userId, trustLevel])
  @@map("devices")
}

model Credential {
  id                      String    @id @default(cuid())
  userId                  String    @map("user_id")
  deviceId                String    @map("device_id")
  /// WebAuthn credential ID — globally unique across TrustID
  credentialId            String    @unique @map("credential_id")
  /// COSE public key only — private key never stored
  publicKey               Bytes     @map("public_key")
  counter                 BigInt    @default(0)
  transports              String    @default("[]")
  aaguid                  String?
  authenticatorAttachment String?   @map("authenticator_attachment")
  credentialDeviceType    String?   @map("credential_device_type")
  backedUp                Boolean   @default(false) @map("backed_up")
  /// User-facing passkey label
  displayName             String?   @map("display_name")
  status                  String    @default("active")
  lastUsedAt              DateTime? @map("last_used_at")
  revokedAt               DateTime? @map("revoked_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credentials")
}

model Session {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  deviceId      String?   @map("device_id")
  applicationId String?   @map("application_id")
  /// standard | temporary
  kind          String    @default("standard")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  ip            String?
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  presentation SessionPresentation?

  @@index([userId])
  @@map("sessions")
}

/// Sealed ephemeral PII for Trust Center UX — ciphertext only, wiped with session.
model SessionPresentation {
  sessionId  String   @id @map("session_id")
  ciphertext String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("session_presentations")
}

/// Cross-device login: unknown device waits for a primary trusted device decision.
model DeviceApprovalRequest {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  applicationId        String?   @map("application_id")
  clientId             String?   @map("client_id")
  applicationName      String?   @map("application_name")
  requestedDeviceName  String    @map("requested_device_name")
  platform             String?
  browser              String?
  location             String?
  ip                   String?
  userAgent            String?   @map("user_agent")
  /// pending | approved | temporary | declined | expired
  status               String    @default("pending")
  pollTokenHash        String    @unique @map("poll_token_hash")
  enrollmentTokenHash  String?   @map("enrollment_token_hash")
  enrollmentTokenExpires DateTime? @map("enrollment_token_expires")
  /// Hash of one-time temporary session token (plaintext never stored)
  oneTimeSessionTokenHash String? @map("one_time_session_token_hash")
  claimConsumedAt      DateTime? @map("claim_consumed_at")
  approvedByDeviceId   String?   @map("approved_by_device_id")
  resultingDeviceId    String?   @map("resulting_device_id")
  expiresAt            DateTime  @map("expires_at")
  resolvedAt           DateTime? @map("resolved_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  approvedByDevice Device?       @relation("ApprovedByDevice", fields: [approvedByDeviceId], references: [id], onDelete: SetNull)
  resultingDevice  Device?       @relation("ResultingDevice", fields: [resultingDeviceId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("device_approval_requests")
}

/// In-app / simulated push notifications for primary trusted devices.
model SecurityNotification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  payload   String    @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("security_notifications")
}

model Application {
  id               String    @id @default(cuid())
  clientId         String    @unique @map("client_id")
  clientSecretHash String?   @map("client_secret_hash")
  name             String
  logoUrl          String?   @map("logo_url")
  type             String    @default("public")
  redirectUris     String    @map("redirect_uris")
  allowedScopes    String    @map("allowed_scopes")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")

  authorizations          Authorization[]
  sessions                Session[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthRefreshTokens      OAuthRefreshToken[]
  deviceApprovalRequests  DeviceApprovalRequest[]

  @@map("applications")
}

model Authorization {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  applicationId String    @map("application_id")
  status        String    @default("active")
  grantedAt     DateTime  @default(now()) @map("granted_at")
  revokedAt     DateTime? @map("revoked_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scopes      AuthorizationScope[]

  @@index([userId])
  @@index([applicationId])
  @@map("authorizations")
}

model AuthorizationScope {
  id              String @id @default(cuid())
  authorizationId String @map("authorization_id")
  scope           String

  authorization Authorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@unique([authorizationId, scope])
  @@map("authorization_scopes")
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique @map("code_hash")
  userId              String    @map("user_id")
  applicationId       String    @map("application_id")
  redirectUri         String    @map("redirect_uri")
  scopes              String
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("oauth_authorization_codes")
}

model OAuthAccessToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique @map("token_hash")
  userId        String    @map("user_id")
  applicationId String    @map("application_id")
  scopes        String
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique @map("token_hash")
  userId        String    @map("user_id")
  applicationId String    @map("application_id")
  scopes        String
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("oauth_refresh_tokens")
}

model DevicePairingRequest {
  id                     String    @id @default(cuid())
  userId                 String    @map("user_id")
  /// Short human-enterable enrollment code (e.g. AB12CD)
  pairingCode            String?   @unique @map("pairing_code")
  requestingDeviceMeta   String    @map("requesting_device_meta")
  status                 String    @default("pending")
  approvedByDeviceId     String?   @map("approved_by_device_id")
  /// One-time token issued after approval for WebAuthn enroll on new device
  enrollmentTokenHash    String?   @map("enrollment_token_hash")
  enrollmentTokenExpires DateTime? @map("enrollment_token_expires")
  expiresAt              DateTime  @map("expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  resolvedAt             DateTime? @map("resolved_at")

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedByDevice Device? @relation("ApprovedByDevice", fields: [approvedByDeviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("device_pairing_requests")
}

model AccountPreferences {
  userId                 String  @id @map("user_id")
  theme                  String  @default("system")
  notificationsEnabled   Boolean @default(true) @map("notifications_enabled")
  privacyShareAnalytics  Boolean @default(false) @map("privacy_share_analytics")
  language               String  @default("en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_preferences")
}

model RecoveryMethod {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  type            String
  contactMethodId String?  @map("contact_method_id")
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactMethod ContactMethod? @relation(fields: [contactMethodId], references: [id], onDelete: SetNull)

  @@map("recovery_methods")
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  type      String
  actorType String   @map("actor_type")
  actorId   String?  @map("actor_id")
  metadata  String   @default("{}")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@map("audit_events")
}

model WebAuthnChallenge {
  id        String    @id @default(cuid())
  userId    String?   @map("user_id")
  /// Legacy alias of purpose (kept for compatibility)
  type      String
  /// registration | authentication | reauthentication | device_addition
  purpose   String    @default("registration")
  challenge String
  expiresAt DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challenge])
  @@index([purpose, userId])
  @@map("webauthn_challenges")
}

/// Future / current high-assurance identity verification ceremonies.
/// No biometric templates. Status must never be inferred from name/photo alone.
model IdentityVerification {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  provider             String
  method               String
  /// pending | verified | failed | expired | revoked | not_verified
  status               String    @default("not_verified")
  providerReference    String?   @map("provider_reference")
  verificationCodeHash String?   @map("verification_code_hash")
  verificationHash     String?   @map("verification_hash")
  /// Linked portrait under review (optional)
  portraitId           String?   @map("portrait_id")
  /// Explicitly false unless a real provider completed verification
  isMock               Boolean   @default(false) @map("is_mock")
  verifiedAt           DateTime? @map("verified_at")
  expiresAt            DateTime? @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  metadata             String    @default("{}")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  portrait IdentityPortrait? @relation(fields: [portraitId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([provider, status])
  @@map("identity_verifications")
}

/**
 * Authoritative TrustID verified identity presentation profile.
 * Owned by TrustID — applications consume assertions; they do not redefine this.
 */
model VerifiedIdentityProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique @map("user_id")
  trustId            String    @unique @map("trust_id")
  /// Commitment only — no plaintext display name at rest
  displayCommitment  String?   @map("display_commitment")
  /// unverified | pending | verified | revoked | suspended
  identityStatus     String    @default("unverified") @map("identity_status")
  /// none | contact | device | mock | document | government | high_assurance
  verificationLevel  String    @default("none") @map("verification_level")
  verificationMethod String?   @map("verification_method")
  identityPortraitId String?   @map("identity_portrait_id")
  portraitVersion    Int       @default(0) @map("portrait_version")
  profileVersion     Int       @default(1) @map("profile_version")
  /// active | revoked | suspended
  status             String    @default("active")
  issuedAt           DateTime? @map("issued_at")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityPortrait IdentityPortrait? @relation("CurrentVerifiedPortrait", fields: [identityPortraitId], references: [id], onDelete: SetNull)

  @@map("verified_identity_profiles")
}

/**
 * Identity portrait lifecycle. Only status=verified is a VERIFIED_IDENTITY_PORTRAIT.
 * User uploads are never automatically verified.
 */
model IdentityPortrait {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  mediaObjectId   String    @map("media_object_id")
  /// none | user_uploaded | pending_verification | verified | rejected | revoked
  status          String    @default("user_uploaded")
  version         Int       @default(1)
  /// SHA-256 of bytes — used for misuse detection, NEVER as identity proof
  contentHash     String    @map("content_hash")
  mimeType        String    @map("mime_type")
  byteSize        Int       @map("byte_size")
  rejectionReason String?   @map("rejection_reason")
  verifiedAt      DateTime? @map("verified_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaObject   IdentityMediaObject    @relation(fields: [mediaObjectId], references: [id], onDelete: Restrict)
  verifications IdentityVerification[]
  currentFor    VerifiedIdentityProfile[] @relation("CurrentVerifiedPortrait")

  @@index([userId, status])
  @@index([contentHash])
  @@map("identity_portraits")
}

/** Private media metadata — bytes live in access-controlled storage, not public buckets. */
model IdentityMediaObject {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  storageKey  String    @unique @map("storage_key")
  mimeType    String    @map("mime_type")
  byteSize    Int       @map("byte_size")
  contentHash String    @map("content_hash")
  purpose     String    @default("identity_portrait")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  portraits IdentityPortrait[]

  @@index([userId])
  @@map("identity_media_objects")
}

/** Suspected impersonation / portrait misuse — never auto-merges accounts. */
model ImpersonationReport {
  id              String    @id @default(cuid())
  reporterUserId  String    @map("reporter_user_id")
  subjectUserId   String?   @map("subject_user_id")
  subjectTrustId  String?   @map("subject_trust_id")
  /// identity_impersonation_report | portrait_misuse_report | identity_conflict
  type            String
  /// open | under_review | resolved | dismissed
  status          String    @default("open")
  reason          String
  evidenceNote    String?   @map("evidence_note")
  metadata        String    @default("{}")
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNote  String?   @map("resolution_note")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  reporter User  @relation("ImpersonationReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  subject  User? @relation("ImpersonationSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([reporterUserId])
  @@index([subjectUserId])
  @@index([status])
  @@map("impersonation_reports")
}

/** Replay protection for signed identity assertions (jti single-use / tracked). */
model AssertionJti {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String    @map("user_id")
  audience  String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("assertion_jtis")
}

/** JWKS signing keys for identity assertions (rotate by adding active keys). */
model AssertionSigningKey {
  id        String    @id @default(cuid())
  kid       String    @unique
  /// AES-GCM sealed JWK JSON — never store private key plaintext
  privateJwkSealed String @map("private_jwk_sealed")
  publicJwk String    @map("public_jwk")
  algorithm String    @default("EdDSA")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  retiredAt DateTime? @map("retired_at")

  @@map("assertion_signing_keys")
}

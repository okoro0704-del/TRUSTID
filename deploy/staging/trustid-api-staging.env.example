# TrustID API — isolated STAGING environment (template; names and policy only, no values).
# Every secret below is generated fresh for staging and never copied from production.
# See docs/security/android-master-device-staging.md and -staging-provisioning.md.

NODE_ENV=production                       # production code paths (MASTER_DEVICE_ATTESTATION=off refused, strict secrets)
TRUSTID_DEPLOY_ENV=staging                # staging trust boundary (startup guard); any other value except "production" fails
DATABASE_URL=${{pgvector.DATABASE_URL_PRIVATE}}   # private network only (the public TCP proxy was removed)
PRISMA_PROVIDER=postgresql

# Secrets: fresh random values generated for staging (never production values)
COOKIE_SECRET=                            # >= 32 chars; also seals Master Device enrollment / removal tokens
SESSION_SECRET=                           # >= 32 chars
PII_PEPPER=                               # >= 32 bytes random
SEAL_KEY=                                 # >= 32 bytes random; seals the OIDC signing keys generated on first boot
MEDIA_SIGNING_SECRET=                     # >= 32 bytes random
WIPE_SECRET=                              # >= 32 bytes random
# OIDC / assertion signing keys are NOT configured: generated on first boot into the staging database
# (sealed with SEAL_KEY), so the staging JWKS kid differs from production's 263c1076162e8c26.

# Identity: staging host only
OIDC_ISSUER=https://<staging-host>/api
ASSERTION_ISSUER=https://<staging-host>
WEBAUTHN_RP_ID=<staging-host>
WEBAUTHN_RP_NAME=TrustID Staging
WEBAUTHN_ORIGIN=https://<staging-host>
CORS_ORIGINS=https://<staging-host>      # HTTP CORS only: does NOT make an origin a trusted passkey origin
# WEBAUTHN_ORIGINS=                       # extra passkey origins, only if needed (staging hosts only)
# Staging Portal relying parties (client ids lifeos_*_staging_public, redirect <origin>/callback;
# their origins are allowed by CORS without credentials). Production Portal clients are never created.
TRUSTID_STAGING_PORTAL_ORIGIN=https://<staging-portal-host>
# TRUSTID_STAGING_ADMIN_ORIGIN=
# TRUSTID_STAGING_BUSINESS_ORIGIN=
# Startup refuses: missing WEBAUTHN_RP_ID / WEBAUTHN_ORIGIN / CORS_ORIGINS / OIDC_ISSUER, any production
# origin (TrustID, LifeOS, *-production.up.railway.app), non-https origins, debug flags, a debug signing
# certificate, a non-staging Android package, and an existing database client redirecting to
# production or local hosts.

# Connected services: leave every *_MODE unset (unbound). Never point staging at production Elfcom,
# DataZone, Lidios, Digiconomy, platform-job or master-distribution engines.
# ELFCOM_MODE= DATAZONE_MODE= LIDIOS_MODE= DIGICONOMY_MODE= PLATFORM_JOB_MODE= MASTER_DISTRIBUTION_MODE=
# FINPROV_MODE=                           # unset = embedded local shim (no external calls)

# Master Device (T3) — enabled on staging only
MASTER_DEVICE_ENROLLMENT=enabled
ANDROID_APP_PACKAGE=com.trustid.device.staging
ANDROID_APP_SIGNING_SHA256=               # staging signing certificate SHA-256, lowercase hex
WEBAUTHN_ANDROID_ORIGINS=                 # android:apk-key-hash:<base64url of the staging certificate SHA-256>
ANDROID_ATTESTATION_MIN_LEVEL=tee         # strongbox for the StrongBox-only acceptance pass
# ANDROID_ATTESTATION_MIN_VERSION=        # unset: built-in floor 3 (Keymaster 4); may only be raised
# ANDROID_ATTESTATION_CLOCK_SKEW_SECONDS= # unset: 300 (max 900)
# ANDROID_ATTESTATION_REVOCATION_CHECK=   # unset: on (fails closed)
# MASTER_DEVICE_ATTESTATION=              # never set
# MASTER_DEVICE_RECOVERY_COOLDOWN_HOURS=  # unset: lost-device replacement blocked
# OTP_EXPOSE_DEBUG= EXPOSE_SESSION_TOKEN_IN_BODY= ALLOW_LEGACY_PII_SCOPES=   # never set

# Netlify staging site (web), set in the Netlify UI of the STAGING site only:
#   TRUSTID_DEPLOY_ENV=staging
#   TRUSTID_API_PROXY_ORIGIN=https://<staging-api>.up.railway.app   (build fails without it; production is refused)
#   TRUSTID_ANDROID_SIGNING_SHA256=<staging cert SHA-256>             (Digital Asset Links; build fails without it)
# GitHub (repository variables / secrets for the Android CI job):
#   vars.TRUSTID_STAGING_ORIGIN, vars.TRUSTID_STAGING_SIGNER_SHA256
#   secrets.TRUSTID_STAGING_KEYSTORE_B64, TRUSTID_STAGING_KEYSTORE_PASSWORD, TRUSTID_STAGING_KEY_ALIAS, TRUSTID_STAGING_KEY_PASSWORD
